{
  "name": "marcosmarcolin/socket.io-server",
  "description": "Socket.IO v4 server for PHP, built on Workerman",
  "type": "library",
  "license": "MIT",
  "keywords": ["socket.io", "websocket", "realtime", "workerman", "engine.io"],
  "authors": [
    {
      "name": "Marcos Marcolin"
    }
  ],
  "require": {
    "php": ">=8.1",
    "ext-json": "*",
    "workerman/workerman": "^5.2"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.3",
    "phpunit/phpunit": "^10.5",
    "squizlabs/php_codesniffer": "^4.0",
    "workerman/channel": "^1.2.3"
  },
  "suggest": {
    "workerman/channel": "Required by ChannelAdapter to broadcast across worker processes"
  },
  "autoload": {
    "psr-4": {
      "MarcosMarcolin\\SocketIO\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "MarcosMarcolin\\SocketIO\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "phpcs": "phpcs",
    "phpstan": "phpstan analyse --memory-limit=512M",
    "lint": ["@phpcs", "@phpstan"]
  },
  "config": {
    "sort-packages": true
  }
}
